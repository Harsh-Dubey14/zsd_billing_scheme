<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <TableSelectDialog
        id="schemeValueHelpDialog"
        title="Select Scheme"
        noDataText="No schemes found."
        items="{schemes>/}"
        search=".onSchemeValueHelpSearch"
        confirm=".onSchemeValueHelpConfirm"
        cancel=".onSchemeValueHelpCancel">

        <columns>
            <Column><Text text="Scheme Name" /></Column>
            <Column><Text text="Scheme Type" /></Column>
            <Column hAlign="End"><Text text="Discount 1" /></Column>
            <Column hAlign="End"><Text text="Discount 2" /></Column>
            <Column hAlign="End"><Text text="Advance Amount" /></Column>
        </columns>

        <items>
            <ColumnListItem type="Active">
                <cells>
                    <Text text="{schemes>SchemeName}" />
                    <Text text="{schemes>SchemeType}" />
                    <Text text="{schemes>Discount1}" />
                    <Text text="{schemes>Discount2}" />
                    <ObjectNumber number="{schemes>AdvAmount}" unit="{schemes>Currency}" />
                </cells>
            </ColumnListItem>
        </items>
    </TableSelectDialog>
</core:FragmentDefinition>
