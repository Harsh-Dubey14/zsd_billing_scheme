<mvc:View controllerName="com.zeel.billingscheme.billingscheme.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    height="100%" displayBlock="true">
    <Page id="page" title="{i18n>title}" showHeader="true" showFooter="false" enableScrolling="true" class="sapUiResponsiveContentPadding zbsPage">
        <content>

            <!-- Selection Criteria -->
            <Panel headerText="Selection Criteria" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
                <HBox wrap="Wrap" class="sapUiSmallMargin zbsSelectionRow">
                    <VBox class="zbsSelectionCol">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0%" />
                        </layoutData>
                        <Label text="Delivery Number(s)" design="Bold" labelFor="deliveryInput" class="sapUiTinyMarginBottom" />

                        <MultiInput id="deliveryInput"
                            width="100%"
                            placeholder="Enter a delivery number and press Enter (comma/space separated for multiple)"
                            submit=".onDeliverySubmit"
                            tokenUpdate=".onDeliveryTokenUpdate" />

                        <HBox class="sapUiTinyMarginTop" wrap="Wrap" alignItems="Center">
                            <Button text="Upload Document" icon="sap-icon://upload" type="Default" press=".onOpenUploadDialog" class="sapUiTinyMarginEnd sapUiTinyMarginTop" />
                            <ToolbarSpacer />
                            <Button text="Clear All" icon="sap-icon://clear-all" type="Transparent" press=".onClearAll" enabled="{/hasDeliveryNumbers}" class="sapUiTinyMarginEnd sapUiTinyMarginTop" />
                            <Button text="Get Delivery Items" icon="sap-icon://action" type="Emphasized" press=".onFetchItems" enabled="{/hasDeliveryNumbers}" class="sapUiTinyMarginTop" />
                        </HBox>
                    </VBox>

                    <VBox class="zbsSelectionCol">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0%" />
                        </layoutData>
                        <Label text="Scheme" design="Bold" labelFor="schemeInput" class="sapUiTinyMarginBottom" />

                        <Input id="schemeInput"
                            width="100%"
                            editable="true"
                            showValueHelp="true"
                            valueHelpRequest=".onSchemeValueHelpRequest"
                            placeholder="Select a scheme..."
                            value="{/schemeSelectedText}" />
                    </VBox>
                </HBox>

                <MessageStrip text="{/schemeSummaryText}" type="Information" showIcon="true" visible="{/hasSchemeDetails}" class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginBottom" />
            </Panel>

            <!-- Delivery Items -->
            <Panel headerText="Delivery Items" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
                <Table id="itemsTable"
                    items="{path: '/items', sorter: {path: 'deliveryNumber', group: true}, groupHeaderFactory: '.getDeliveryGroupHeader'}"
                    noDataText="No delivery items yet. Enter delivery number(s) above and choose &quot;Get Delivery Items&quot;."
                    sticky="ColumnHeaders,HeaderToolbar,GroupHeaders"
                    growing="true"
                    growingThreshold="50"
                    autoPopinMode="true"
                    popinLayout="GridSmall"
                    class="zbsItemsTable">
                    

                    <columns>
                        <Column width="4rem" hAlign="Begin" importance="High"><Text text="Sr No." /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" importance="High"><Text text="Product" /></Column>
                        <Column width="7rem" minScreenWidth="Tablet" demandPopin="true" importance="Medium"><Text text="Color" /></Column>
                        <Column width="6rem" importance="High"><Text text="Size" /></Column>
                        <Column width="8rem" minScreenWidth="Desktop" demandPopin="true" importance="Low"><Text text="Brand" /></Column>
                        <Column width="7rem" minScreenWidth="Desktop" demandPopin="true" importance="Low"><Text text="HSN Code" /></Column>
                        <Column width="5rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" importance="Medium"><Text text="Bag" /></Column>
                        <Column width="5rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" importance="Medium"><Text text="Pack" /></Column>
                        <Column width="5.5rem" hAlign="End" importance="High"><Text text="Qty" /></Column>
                        <Column width="5rem" minScreenWidth="Tablet" demandPopin="true" importance="Medium"><Text text="Unit" /></Column>
                        <Column width="7rem" hAlign="End" importance="High"><Text text="Rate" /></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{srNo}" />
                                <Text text="{product}" />
                                <Text text="{color}" />
                                <Text text="{size}" />
                                <Text text="{brand}" />
                                <Text text="{hsnCode}" />
                                <Text text="{bag}" />
                                <Text text="{pack}" />
                                <Text text="{qty}" />
                                <Text text="{unit}" />
                                <ObjectNumber number="{rate}" unit="INR" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <!-- Billing / Scheme Calculation -->
            <Panel headerText="Billing Details" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
                <Table id="billingTable"
                    items="{/billingItems}"
                    noDataText="No billing details yet. Fetch delivery items and select a scheme above."
                    sticky="ColumnHeaders,HeaderToolbar"
                    growing="true"
                    growingThreshold="50"
                    autoPopinMode="false"
                    class="zbsItemsTable zbsBillingTable">

                    <columns>
                        <Column width="3.5rem" hAlign="Begin"><Text text="Sr No." /></Column>
                        <Column width="4.5rem" hAlign="End"><Text text="Qty" /></Column>
                        <Column width="4rem"><Text text="Unit" /></Column>
                        <Column width="5.5rem" hAlign="End"><Text text="Rate" /></Column>
                        <Column width="8rem"><Text text="Scheme Name" /></Column>
                        <Column width="6rem"><Text text="Scheme Type" /></Column>
                        <Column width="4rem" hAlign="End"><Text text="Dis 1" /></Column>
                        <Column width="4rem" hAlign="End"><Text text="Dis 2" /></Column>
                        <Column width="6.5rem" hAlign="End"><Text text="Rate After Dis A" /></Column>
                        <Column width="6.5rem" hAlign="End"><Text text="Rate After Dis B" /></Column>
                        <Column width="7rem" hAlign="End"><Text text="Value after Dis B" /></Column>
                        <Column width="4.5rem" hAlign="End"><Text text="GST %" /></Column>
                        <Column width="5.5rem" hAlign="End"><Text text="GST Value" /></Column>
                        <Column width="5.5rem" hAlign="End"><Text text="Total" /></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{srNo}" />
                                <Text text="{qty}" />
                                <Text text="{unit}" />
                                <ObjectNumber number="{rate}" unit="INR" />
                                <Text text="{schemeName}" />
                                <Text text="{schemeType}" />
                                <Text text="{discount1}" />
                                <Text text="{discount2}" />
                                <ObjectNumber number="{rateAfterDisA}" unit="INR" />
                                <ObjectNumber number="{rateAfterDisB}" unit="INR" />
                                <ObjectNumber number="{valueAfterDisB}" unit="INR" />
                                <Text text="{gstPercent}" />
                                <ObjectNumber number="{gstValue}" unit="INR" />
                                <ObjectNumber number="{total}" unit="INR" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <HBox class="sapUiSmallMargin" wrap="Wrap" alignItems="Center">
                    <ToolbarSpacer />
                    <Button text="Post" icon="sap-icon://accept" type="Emphasized" press=".onPostScheme" enabled="{= ${/billingItems}.length > 0 }" />
                </HBox>
            </Panel>

        </content>
    </Page>
</mvc:View>
