<mvc:View controllerName="com.zeel.billingscheme.billingscheme.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    height="100%" displayBlock="true">
    <Page id="page" title="{i18n>title}" showHeader="true" showFooter="false" enableScrolling="true" class="sapUiResponsiveContentPadding zbsPage">
        <content>

            <!-- Selection Criteria -->
            <Panel headerText="Selection Criteria" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
                <HBox wrap="Wrap" class="sapUiMediumMargin zbsSelectionRow">
                    <VBox class="zbsSelectionCol">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0%" />
                        </layoutData>
                        <Label text="Delivery Number(s)" design="Bold" labelFor="deliveryInput" class="sapUiSmallMarginBottom" />

                        <MultiInput id="deliveryInput"
                            width="100%"
                            placeholder="Enter delivery number and press Enter"
                            showValueHelp="true"
                            valueHelpRequest=".onDeliveryValueHelpRequest"
                            submit=".onDeliverySubmit"
                            tokenUpdate=".onDeliveryTokenUpdate" />

                        <HBox class="sapUiSmallMarginTop" wrap="Wrap" alignItems="Center" justifyContent="SpaceBetween">
                            <HBox wrap="Wrap" alignItems="Center">
                                <Button text="Upload" icon="sap-icon://upload" type="Default" press=".onOpenUploadDialog" class="sapUiTinyMarginEnd" />
                                <Button text="Clear" icon="sap-icon://delete" type="Transparent" press=".onClearAll" enabled="{/hasDeliveryNumbers}" />
                            </HBox>
                            <Button text="Fetch Delivery Items" icon="sap-icon://arrow-right" type="Emphasized" press=".onFetchItems" enabled="{/hasDeliveryNumbers}" />
                        </HBox>
                    </VBox>

                    <VBox class="zbsSelectionCol">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0%" />
                        </layoutData>
                        <Label text="Scheme Type" design="Bold" labelFor="schemeTypeSelect" class="sapUiSmallMarginBottom" />
                        <Select id="schemeTypeSelect" width="100%" selectedKey="{/schemeType}" change=".onSchemeTypeChange">
                            <core:Item key="" text="Clear" />
                            <core:Item key="regular" text="Regular" />
                            <core:Item key="advance" text="Advance" />
                        </Select>
                    </VBox>

                    <VBox class="zbsSelectionCol">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="0%" />
                        </layoutData>
                        <Label text="Scheme" design="Bold" labelFor="schemeInput" class="sapUiSmallMarginBottom" />

                        <Input id="schemeInput"
                            width="100%"
                            showValueHelp="true"
                            valueHelpRequest=".onSchemeValueHelpRequest"
                            placeholder="Select a scheme..."
                            value="{/schemeSelectedText}" />
                    </VBox>
                </HBox>

                <MessageStrip text="{/schemeSummaryText}" type="Information" showIcon="true" visible="{/hasSchemeDetails}" class="sapUiMediumMarginBegin sapUiMediumMarginEnd sapUiSmallMarginBottom" />
            </Panel>

            <!-- Delivery Items -->
            <Panel headerText="Delivery Items" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
                <Table id="itemsTable"
                    items="{path: '/items', sorter: {path: 'deliveryNumber'}}"
                    noDataText="No delivery items yet. Enter delivery number(s) and click 'Fetch Delivery Items'."
                    sticky="ColumnHeaders,HeaderToolbar"
                    growing="true"
                    growingThreshold="50"
                    autoPopinMode="true"
                    popinLayout="GridSmall"
                    class="zbsItemsTable sapUiResponsiveMargin">
                    

                    <columns>
                        <Column width="4rem" hAlign="Begin" importance="High"><Text text="Sr No." /></Column>
                        <Column width="8rem" importance="High"><Text text="Delivery No" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" importance="High"><Text text="Customer Name" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" importance="High"><Text text="Product" /></Column>
                        <Column width="7rem" minScreenWidth="Tablet" demandPopin="true" importance="Medium"><Text text="Color" /></Column>
                        <Column width="6rem" importance="High"><Text text="Size" /></Column>
                        <Column width="8rem" minScreenWidth="Desktop" demandPopin="true" importance="Low"><Text text="Brand" /></Column>
                        <Column width="7rem" minScreenWidth="Desktop" demandPopin="true" importance="Low"><Text text="HSN Code" /></Column>
                        <Column width="5rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" importance="Medium"><Text text="Bag" /></Column>
                        <Column width="5rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true" importance="Medium"><Text text="Pack" /></Column>
                        <Column width="9rem" hAlign="End" importance="High"><Text text="Qty" /></Column>
                        <Column width="7rem" hAlign="End" importance="High"><Text text="Rate" /></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{srNo}" />
                                <Text text="{deliveryNumber}" />
                                <Text text="{customerName}" />
                                <Text text="{product}" />
                                <Text text="{color}" />
                                <Text text="{size}" />
                                <Text text="{brand}" />
                                <Text text="{hsnCode}" />
                                <Text text="{bag}" />
                                <Text text="{pack}" />
                                <Text text="{= ${qty} + ' ' + ${unit} + ' (' + ${quantityinbaseunit} + ' ' + ${actualUom} + ')' }" />
                                <ObjectNumber number="{rate}" unit="INR" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <!-- Billing / Scheme Calculation -->
            <Panel headerText="Billing Details" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
                <Table id="billingTable"
                    items="{/billingItems}"
                    noDataText="No billing details yet. Fetch delivery items and select a scheme."
                    sticky="ColumnHeaders,HeaderToolbar"
                    growing="true"
                    growingThreshold="50"
                    autoPopinMode="false"
                    class="zbsItemsTable zbsBillingTable">

                    <columns>
                        <Column width="3.5rem" hAlign="Begin"><Text text="Sr No." /></Column>
                        <Column width="8rem" hAlign="End"><Text text="Qty" /></Column>
                        <Column width="5.5rem" hAlign="End"><Text text="Rate" /></Column>
                        <Column width="4rem" hAlign="End"><Text text="Dis 1" /></Column>
                        <Column width="6.5rem" hAlign="End"><Text text="Rate After Dis A" /></Column>
                        <Column width="7rem" hAlign="End"><Text text="Value After Dis A" /></Column>
                        <Column width="4rem" hAlign="End"><Text text="Dis 2" /></Column>
                        <Column width="7rem" hAlign="End"><Text text="Value after Dis B" /></Column>
                        <Column width="4.5rem" hAlign="End"><Text text="GST %" /></Column>
                        <Column width="5.5rem" hAlign="End"><Text text="GST Value" /></Column>
                        <Column width="5.5rem" hAlign="End"><Text text="Total" /></Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{srNo}" />
                                <Text text="{= ${qty} + ' ' + ${unit} + ' (' + ${quantityinbaseunit} + ' ' + ${actualUom} + ')' }" />
                                <ObjectNumber number="{rate}" unit="INR" />
                                <Text text="{discount1}" />
                                <ObjectNumber number="{rateAfterDisA}" unit="INR" />
                                <ObjectNumber number="{valueAfterDisA}" unit="INR" />
                                <Text text="{discount2}" />
                                <ObjectNumber number="{valueAfterDisB}" unit="INR" />
                                <Text text="{gstPercent}" />
                                <ObjectNumber number="{gstValue}" unit="INR" />
                                <ObjectNumber number="{total}" unit="INR" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <MessageStrip text="{/schemeErrorText}" type="Error" showIcon="true" visible="{= !${/schemeValid} }" class="sapUiMediumMarginBegin sapUiMediumMarginEnd sapUiMediumMarginTop" />

                <HBox class="sapUiMediumMargin" wrap="Wrap" alignItems="Center" justifyContent="End">
                    <VBox alignItems="End">
                        <Label text="Billing Total" design="Bold" class="sapUiTinyMarginBottom" />
                        <ObjectNumber
                            number="{/billingTotal}"
                            unit="INR"
                            emphasized="true"
                            state="{= ${/schemeValid} ? 'None' : 'Error' }"
                            class="sapUiLargeMarginEnd" />
                    </VBox>
                    <Button text="Post Scheme" icon="sap-icon://accept" type="Emphasized" press=".onPostScheme" enabled="{= ${/billingItems}.length > 0 &amp;&amp; ${/schemeValid} }" />
                </HBox>
            </Panel>

        </content>
    </Page>
</mvc:View>
